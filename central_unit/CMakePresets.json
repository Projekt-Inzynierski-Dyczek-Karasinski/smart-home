{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "native_debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TARGET_DEVICE": "NATIVE",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "native_debug_coverage",
      "inherits": "native_debug",
      "cacheVariables": {
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "native_debug_asan",
      "inherits": "native_debug",
      "cacheVariables": {
        "ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "native_debug_tsan",
      "inherits": "native_debug",
      "cacheVariables": {
        "ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "native",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TARGET_DEVICE": "NATIVE",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "rpi_zero_2w",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/rpi_zero_2w_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TARGET_DEVICE": "RPI_ZERO_2W"
      }
    }
  ]
}